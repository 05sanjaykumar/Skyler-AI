// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native","darwin-arm64","debian-openssl-1.1.x"]
  output   = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid()) // or Int @default(autoincrement())
  name          String?
  email         String?   @unique
  emailVerified DateTime? // needed for NextAuth adapter
  image         String?   // from OAuth profile
  hashedPassword String?  // for email/password authentication
  accounts      Account[]
  sessions      Session[]
  aiInstances      AIInstance[]
  transactions  Transaction[]
  dailyCreditUsage DailyCreditUsage[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Usage tracking for pay-per-request
  creditsRemaining   Int      @default(0) 
  maxInstances       Int      @default(3)
  planExpirationDate     DateTime?              
}


model Account {
  id                 String   @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  @@unique([provider, providerAccountId])
}


model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
}

enum Platform {
  GMAIL
  OUTLOOK
  WHATSAPP
  SLACK
  DISCORD
  TELEGRAM
}
model AIInstance {
  id          String         @id @default(cuid())
  userId      String
  name        String
  promptName  String?
  platform    Platform   @default(GMAIL)
  ruleBox    String?   // New field for rule box items
  webhook      String?   // optional webhook for pushing filtered data
  promptDecode Json?     // JSON with structured filters (gmailFilters, aiFilterRules, etc.)

  user User @relation(fields: [userId], references: [id])
}

model Transaction {
  id               String   @id @default(cuid())
  userId           String
  amount           Float
  currency         String   @default("USD")
  creditsBought    Int      @default(0)
  paymentProvider  String?              // PayPal, Cashfree, Wise...
  providerTxnId    String?  @unique            // external txn/order id
  status           String   @default("pending") // pending, success, failed, refunded
  metadata         Json?                // optional: store raw gateway response
  type             String?              // e.g. "credits_purchase", "subscription"

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}


model DailyCreditUsage {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime // store as start-of-day UTC to keep unique per day
  creditsUsed Int    @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date]) // one row per user per day
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactUsMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
