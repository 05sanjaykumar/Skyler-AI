// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "darwin-arm64"]
  output   = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  PRO
  PREMIUM
}

enum InstanceStatus {
  ACTIVE
  PAUSED
  UNPAID
}
model User {
  id            String    @id @default(cuid()) // or Int @default(autoincrement())
  name          String?
  email         String?   @unique
  emailVerified DateTime? // needed for NextAuth adapter
  image         String?   // from OAuth profile
  hashedPassword String?  // for email/password authentication
  accounts      Account[]
  sessions      Session[]
  aiInstances      AIInstance[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscriptionTier SubscriptionTier @default(FREE)
  subscriptionStart DateTime? // when the subscription started
  subscriptionEnd DateTime? // when the subscription ends, if applicable

  // Current usage tracking
  usedInstances    Int      @default(0)
  usedPrompts      Int      @default(0)
}


model Account {
  id                 String   @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  @@unique([provider, providerAccountId])
}


model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
}

model AIInstance {
  id          String         @id @default(cuid())
  userId      String
  name        String
  promptName  String?
  status      InstanceStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])
}