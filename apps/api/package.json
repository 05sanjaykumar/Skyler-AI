{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",              
    "start": "node dist/server.js",
    "migrate:dev": "dotenv -e .env -- pnpm prisma migrate dev --schema=../../packages/prisma/schema.prisma",
    "migrate:reset": "dotenv -e .env -- pnpm prisma migrate reset --force --skip-seed --schema=../../packages/prisma/schema.prisma",
    "prisma:generate:dev": "dotenv -e .env -- pnpm prisma generate --schema=../../packages/prisma/schema.prisma",
    "test": "dotenv -e .env.test jest --runInBand --detectOpenHandles",
    "test:prepare": "dotenv -e .env.test -- pnpm prisma migrate reset --force --skip-seed --schema=../../packages/prisma/schema.prisma --skip-generate",
    "prisma:generate:test": "dotenv -e .env.test -- pnpm prisma generate --schema=../../packages/prisma/schema.prisma",
    "migrate:prod": "dotenv -e .env.production -- pnpm prisma migrate deploy --schema=../../packages/prisma/schema.prisma",
    "prisma:generate:prod": "dotenv -e .env.production -- pnpm prisma generate --schema=../../packages/prisma/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@auth/core": "0.34.2",
    "@auth/supabase-adapter": "^1.10.0",
    "@langchain/groq": "^0.2.3",
    "@paypal/paypal-server-sdk": "^1.1.0",
    "@prisma/client": "^6.13.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cashfree-pg": "^5.0.8",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "googleapis": "^155.0.1",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.30",
    "natural": "^8.1.0",
    "next-auth": "^4.24.11",
    "pg": "^8.16.3",
    "resend": "^6.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "jest": "^30.1.1",
    "prisma": "^6.13.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
