{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "typeRoots": ["./types", "./node_modules/@types"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
       "@skyler-ai/*": ["../../*"],
      "@skyler-ai/prisma": ["../../packages/prisma/src/client"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
